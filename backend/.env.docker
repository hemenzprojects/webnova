APP_NAME="WebNova CMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_KEY=base64:e0RG/N6S8ipuo7lUdJkkTtvfI10Tnms0tO+nw3efMPg=

# Your platform domain — requests to this go to central admin, everything else is tenant
CENTRAL_DOMAIN=platform.local

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# PostgreSQL — matches Fly.io (host/port overridden by docker-compose)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=webnova_central
DB_USERNAME=webnova
DB_PASSWORD=secret

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=local

# Nuxt SSR calls back to nginx internally
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_API_BASE_SSR=http://127.0.0.1:8080/api/v1

MAIL_MAILER=log