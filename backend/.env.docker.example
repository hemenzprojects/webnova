APP_NAME="WebNova CMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Your platform domain — requests to this go to central admin, everything else is tenant
CENTRAL_DOMAIN=platform.local

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# PostgreSQL — matches Fly.io (host/port overridden by docker-compose)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=webnova_central
DB_USERNAME=webnova
DB_PASSWORD=secret

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=local
# Storage each site may use unless it has its own limit (Platform → Tenants)
TENANT_STORAGE_LIMIT_MB=1024
# Count each site's database towards its usage as well as its files
TENANT_STORAGE_INCLUDE_DATABASE=true
# Total storage to share between sites; empty = size of the storage volume
STORAGE_CAPACITY_MB=

# Nuxt SSR calls back to nginx internally
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_API_BASE_SSR=http://127.0.0.1:8080/api/v1

MAIL_MAILER=log